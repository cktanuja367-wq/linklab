# ==========================================
# LABLINK SERVER CONFIGURATION
# ==========================================
# Google Gemini API Key for AI equipment discovery and project dependency planning
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional override passcodes for Faculty and Admin portal logins.
# If left empty, you can set your chosen Faculty and Admin passwords directly in the app on first launch.
FACULTY_PASSCODE=
ADMIN_PASSCODE=

# Public URL where this applet is hosted
APP_URL="MY_APP_URL"

# Optional comma-separated allowed frontend origins for CORS when deploying separately
CORS_ORIGINS=
